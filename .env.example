# Copy to .env.local and fill in after creating your Supabase project.
# The app runs fully offline without these — the backend is backup + M-Pesa.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Edge Function secrets (set with: supabase secrets set MPESA_PASSKEY=...)
# Never expose these to the browser.
# MPESA_PASSKEY=
# SUPABASE_SERVICE_ROLE_KEY= (auto-provided inside Edge Functions)
